{
  "name": "liuyao-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @liuyao/web dev",
    "build": "pnpm -r run build",
    "test": "bash scripts/check_test_placement.sh && pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome format --write . && prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,yml,yaml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "license": "AGPL-3.0-only"
}
