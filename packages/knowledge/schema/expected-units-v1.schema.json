{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://liuyao.invalid/schema/expected-units-v1.schema.json",
  "title": "Liuyao expected audit units v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryId",
    "registryRevision",
    "inventory",
    "counts",
    "layers",
    "hexagrams",
    "specialPassages",
    "groups",
    "exclusions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "registryId": { "const": "knowledge-expected-units-v1" },
    "registryRevision": { "type": "integer", "minimum": 1 },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "docs/reviews/knowledge/source-inventory.md" },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overviewCells",
        "positionCells",
        "hexagramCells",
        "specialPassages",
        "groups",
        "exclusions"
      ],
      "properties": {
        "overviewCells": { "type": "integer", "minimum": 0 },
        "positionCells": { "type": "integer", "minimum": 0 },
        "hexagramCells": { "type": "integer", "minimum": 0 },
        "specialPassages": { "type": "integer", "minimum": 0 },
        "groups": { "type": "integer", "minimum": 0 },
        "exclusions": { "type": "integer", "minimum": 0 }
      }
    },
    "layers": { "type": "array", "items": { "$ref": "#/definitions/layer" } },
    "hexagrams": { "type": "array", "items": { "$ref": "#/definitions/hexagram" } },
    "specialPassages": { "type": "array", "items": { "$ref": "#/definitions/special" } },
    "groups": { "type": "array", "items": { "$ref": "#/definitions/group" } },
    "exclusions": { "type": "array", "items": { "$ref": "#/definitions/exclusion" } }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "featureId": { "type": "string", "pattern": "^feat-[0-9]{3}$" },
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$" },
    "pageStart": { "type": "integer", "minimum": 1 },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "editionId", "class", "label", "sourceAnchor", "rosterStatus"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "editionId": { "type": "string", "minLength": 1 },
        "class": {
          "enum": [
            "original-text",
            "translation",
            "author-commentary",
            "commentator",
            "translator-note",
            "supplement"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "sourceAnchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inventoryAnchor", "citationIds"],
          "properties": {
            "inventoryAnchor": { "type": "string", "minLength": 1 },
            "citationIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "rosterStatus": { "enum": ["unresolved", "resolved"] }
      }
    },
    "layerScopeIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/id" }
    },
    "hexagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "auditFeatureId", "requiredCells", "books", "specialPassageIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^hexagram-(0[1-9]|[1-5][0-9]|6[0-4])$" },
        "number": { "type": "integer", "minimum": 1, "maximum": 64 },
        "auditFeatureId": { "$ref": "#/definitions/featureId" },
        "requiredCells": {
          "type": "array",
          "items": {
            "enum": [
              "overview",
              "position-1",
              "position-2",
              "position-3",
              "position-4",
              "position-5",
              "position-6"
            ]
          },
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true
        },
        "books": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "editionId",
              "sourceUnitId",
              "pdfPageStart",
              "pdfPageEnd",
              "layerScopeIds"
            ],
            "properties": {
              "editionId": { "type": "string", "minLength": 1 },
              "sourceUnitId": { "$ref": "#/definitions/id" },
              "pdfPageStart": { "$ref": "#/definitions/pageStart" },
              "pdfPageEnd": { "$ref": "#/definitions/pageStart" },
              "layerScopeIds": { "$ref": "#/definitions/layerScopeIds" }
            }
          }
        },
        "specialPassageIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/id" }
        }
      }
    },
    "special": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hexagramId",
        "editionId",
        "sourceUnitId",
        "auditFeatureId",
        "pdfPageStart",
        "pdfPageEnd",
        "layerScopeIds"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "hexagramId": { "type": "string", "pattern": "^hexagram-0[12]$" },
        "editionId": { "type": "string", "minLength": 1 },
        "sourceUnitId": { "$ref": "#/definitions/id" },
        "auditFeatureId": { "$ref": "#/definitions/featureId" },
        "pdfPageStart": { "$ref": "#/definitions/pageStart" },
        "pdfPageEnd": { "$ref": "#/definitions/pageStart" },
        "layerScopeIds": { "$ref": "#/definitions/layerScopeIds" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "group",
        "editionId",
        "pdfPageStart",
        "pdfPageEnd",
        "authorFeatureId",
        "auditFeatureId",
        "layerScopeIds",
        "discoveryStatus"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "parentId": { "$ref": "#/definitions/id" },
        "number": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["content", "non-content"] },
        "group": { "type": "string", "minLength": 1 },
        "editionId": { "type": "string", "minLength": 1 },
        "pdfPageStart": { "$ref": "#/definitions/pageStart" },
        "pdfPageEnd": { "$ref": "#/definitions/pageStart" },
        "authorFeatureId": { "$ref": "#/definitions/featureId" },
        "auditFeatureId": { "$ref": "#/definitions/featureId" },
        "layerScopeIds": { "$ref": "#/definitions/layerScopeIds" },
        "discoveryStatus": { "enum": ["unresolved", "resolved"] },
        "recordIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceUnitId",
        "kind",
        "inventoryAnchor",
        "editionId",
        "auditFeatureId",
        "layerScopeIds"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "sourceUnitId": { "$ref": "#/definitions/id" },
        "kind": { "type": "string", "minLength": 1 },
        "inventoryAnchor": { "type": "string", "minLength": 1 },
        "editionId": { "type": "string", "minLength": 1 },
        "auditFeatureId": { "$ref": "#/definitions/featureId" },
        "layerScopeIds": { "$ref": "#/definitions/layerScopeIds" }
      }
    }
  }
}
