{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://liuyao.local/schemas/knowledge/citations-v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "editionId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "chapter": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "section": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "pdfPageStart": {
                "type": "integer",
                "minimum": 1
              },
              "pdfPageEnd": {
                "type": "integer",
                "minimum": 1
              },
              "printedPageStart": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "printedPageEnd": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": ["chapter", "section", "pdfPageStart", "pdfPageEnd"]
          },
          "textLayer": {
            "enum": [
              "original-text",
              "author-commentary",
              "translator-note",
              "supplement",
              "technical-exposition"
            ]
          },
          "attributedTo": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": ["id", "sourceId", "editionId", "location", "textLayer"]
      },
      "minItems": 1
    }
  },
  "required": ["schemaVersion", "citations"]
}
