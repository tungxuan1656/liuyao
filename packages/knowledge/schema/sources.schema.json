{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://liuyao.local/schemas/knowledge/sources-v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "contributors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          },
          "editions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "pdfPageCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "localInputPath": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "publication": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "publisher": {
                      "type": ["string", "null"]
                    },
                    "year": {
                      "type": ["integer", "null"]
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": ["publisher", "year", "note"]
                },
                "rights": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "const": "unconfirmed"
                    },
                    "use": {
                      "const": "research-only"
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": ["status", "use", "note"]
                }
              },
              "required": [
                "id",
                "label",
                "sha256",
                "pdfPageCount",
                "localInputPath",
                "publication",
                "rights"
              ]
            },
            "minItems": 1
          }
        },
        "required": ["id", "title", "author", "contributors", "editions"]
      },
      "minItems": 1
    }
  },
  "required": ["schemaVersion", "sources"]
}
