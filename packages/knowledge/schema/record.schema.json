{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(trigram|hexagram|term|rule|article|lesson)-[a-z0-9-]+$"
    },
    "type": {
      "enum": ["trigram", "hexagram", "term", "rule", "article"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["draft", "ready"]
    },
    "listed": {
      "type": "boolean"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "topicIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "relatedIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "applicableRuleIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recordId": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "sectionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["recordId"]
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "kingWenNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "upperTrigramId": {
      "type": "string",
      "minLength": 1
    },
    "lowerTrigramId": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "element": {
      "enum": ["wood", "fire", "earth", "metal", "water"]
    },
    "ruleset": {
      "const": "liuyao-standard-v1"
    },
    "category": {
      "enum": ["metadata", "structure", "transformation", "classification"]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "lines": {
      "type": "array"
    },
    "specialPassages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/entry"
            },
            "minItems": 1
          }
        },
        "required": ["title", "entries"]
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "palaces"
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "trigramId": {
                      "type": "string",
                      "pattern": "^trigram-[a-z0-9-]+$"
                    },
                    "element": {
                      "enum": ["wood", "fire", "earth", "metal", "water"]
                    },
                    "hexagramIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^hexagram-(0[1-9]|[1-5][0-9]|6[0-4])$"
                      },
                      "minItems": 8,
                      "maxItems": 8,
                      "uniqueItems": true
                    }
                  },
                  "required": ["trigramId", "element", "hexagramIds"]
                },
                "minItems": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                },
                "minItems": 1
              }
            },
            "required": ["kind", "rows", "references"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "na-jia"
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "trigramId": {
                      "type": "string",
                      "pattern": "^trigram-[a-z0-9-]+$"
                    },
                    "inner": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "stemId": {
                            "type": "string",
                            "pattern": "^term-[a-z0-9-]+$"
                          },
                          "branchId": {
                            "type": "string",
                            "pattern": "^term-[a-z0-9-]+$"
                          }
                        },
                        "required": ["stemId", "branchId"]
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "outer": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "stemId": {
                            "type": "string",
                            "pattern": "^term-[a-z0-9-]+$"
                          },
                          "branchId": {
                            "type": "string",
                            "pattern": "^term-[a-z0-9-]+$"
                          }
                        },
                        "required": ["stemId", "branchId"]
                      },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  },
                  "required": ["trigramId", "inner", "outer"]
                },
                "minItems": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                },
                "minItems": 1
              }
            },
            "required": ["kind", "rows", "references"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "markers"
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "palaceSequence": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8
                    },
                    "shiPosition": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 6
                    },
                    "yingPosition": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 6
                    },
                    "stage": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["palaceSequence", "shiPosition", "yingPosition"]
                },
                "minItems": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                },
                "minItems": 1
              }
            },
            "required": ["kind", "rows", "references"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "branch-elements"
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "branchId": {
                      "type": "string",
                      "pattern": "^term-[a-z0-9-]+$"
                    },
                    "element": {
                      "enum": ["wood", "fire", "earth", "metal", "water"]
                    }
                  },
                  "required": ["branchId", "element"]
                },
                "minItems": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                },
                "minItems": 1
              }
            },
            "required": ["kind", "rows", "references"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "element-cycles"
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "from": {
                      "enum": ["wood", "fire", "earth", "metal", "water"]
                    },
                    "relation": {
                      "enum": ["generates", "controls"]
                    },
                    "to": {
                      "enum": ["wood", "fire", "earth", "metal", "water"]
                    }
                  },
                  "required": ["from", "relation", "to"]
                },
                "minItems": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                },
                "minItems": 1
              }
            },
            "required": ["kind", "rows", "references"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "relative-relations"
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "relation": {
                      "enum": [
                        "same",
                        "palace-generates-line",
                        "palace-controls-line",
                        "line-controls-palace",
                        "line-generates-palace"
                      ]
                    },
                    "relativeId": {
                      "type": "string",
                      "pattern": "^term-[a-z0-9-]+$"
                    }
                  },
                  "required": ["relation", "relativeId"]
                },
                "minItems": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                },
                "minItems": 1
              }
            },
            "required": ["kind", "rows", "references"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "coin-outcomes"
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sapCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    },
                    "nguaCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    },
                    "lineClass": {
                      "enum": ["young-yang", "young-yin", "old-yang", "old-yin"]
                    },
                    "polarity": {
                      "enum": ["yin", "yang"]
                    },
                    "changing": {
                      "type": "boolean"
                    }
                  },
                  "required": ["sapCount", "nguaCount", "lineClass", "polarity", "changing"]
                },
                "minItems": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                },
                "minItems": 1
              }
            },
            "required": ["kind", "rows", "references"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "transformation"
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "primaryHexagramId": {
                      "type": "string",
                      "pattern": "^hexagram-(0[1-9]|[1-5][0-9]|6[0-4])$"
                    },
                    "changedHexagramId": {
                      "type": "string",
                      "pattern": "^hexagram-(0[1-9]|[1-5][0-9]|6[0-4])$"
                    },
                    "movingPositions": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 6
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "primaryLines": {
                      "type": "array",
                      "items": {
                        "enum": ["yin", "yang"]
                      },
                      "minItems": 6,
                      "maxItems": 6
                    },
                    "changedLines": {
                      "type": "array",
                      "items": {
                        "enum": ["yin", "yang"]
                      },
                      "minItems": 6,
                      "maxItems": 6
                    }
                  },
                  "required": [
                    "primaryHexagramId",
                    "changedHexagramId",
                    "movingPositions",
                    "primaryLines",
                    "changedLines"
                  ]
                },
                "minItems": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                },
                "minItems": 1
              }
            },
            "required": ["kind", "rows", "references"]
          }
        ]
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "references": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/reference"
                  },
                  "minItems": 1
                }
              },
              "required": ["id", "text", "references"]
            },
            "minItems": 1
          },
          "orientation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                },
                "minItems": 1
              }
            },
            "required": ["description", "references"]
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/reference"
            },
            "minItems": 1
          },
          "authorAlternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "author": {
                  "type": "string",
                  "minLength": 1
                },
                "via": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "references": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/reference"
                  },
                  "minItems": 1
                }
              },
              "required": ["author", "description", "references"]
            }
          }
        },
        "required": ["id", "kind", "title", "labels", "orientation", "references"]
      }
    }
  },
  "required": ["id", "type", "title", "status", "entries"],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Linked learning content",
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1
        },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "author": {
              "type": "string",
              "minLength": 1
            },
            "via": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["author"]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "recordId": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "sectionId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["recordId"]
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["table", "figure"]
            },
            "recordId": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "recordId", "id"]
        }
      },
      "required": ["text", "references"]
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceId": {
              "type": "string",
              "minLength": 1
            },
            "pdfPages": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "printedPages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "section": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["sourceId", "pdfPages"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "documentPath": {
              "type": "string",
              "minLength": 1
            },
            "section": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["documentPath", "section"]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "hexagram"
          }
        }
      },
      "then": {
        "required": ["kingWenNumber", "upperTrigramId", "lowerTrigramId", "lines"],
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                },
                "polarity": {
                  "enum": ["yin", "yang"]
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "entries": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/entry"
                  }
                }
              },
              "required": ["position", "polarity", "label", "entries"]
            },
            "minItems": 6,
            "maxItems": 6
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "trigram"
          }
        }
      },
      "then": {
        "required": ["lines", "symbol", "element"],
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "enum": ["yin", "yang"]
            },
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rule"
          }
        }
      },
      "then": {
        "required": ["ruleset", "category"]
      }
    }
  ]
}
