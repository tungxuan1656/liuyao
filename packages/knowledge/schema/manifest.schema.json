{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://liuyao.local/schemas/knowledge/manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "corpusId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "language": {
      "const": "vi"
    },
    "sourceFile": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "citationFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "recordFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "releaseIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "track": {
            "enum": ["shared", "classical", "liuyao"]
          },
          "status": {
            "enum": ["partial", "pending", "reviewed"]
          }
        },
        "required": ["id", "title", "track", "status"]
      },
      "minItems": 1
    },
    "coverageAuthors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "nextBatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hexagramIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "topicIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": ["hexagramIds", "topicIds", "note"]
    }
  },
  "required": [
    "schemaVersion",
    "corpusId",
    "language",
    "sourceFile",
    "citationFiles",
    "recordFiles",
    "releaseIds",
    "topics",
    "coverageAuthors",
    "nextBatch"
  ]
}
