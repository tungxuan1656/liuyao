{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://liuyao.invalid/schema/audit-certification-v1.schema.json",
  "title": "Liuyao audit certification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentSnapshotIdentity",
    "registry",
    "decisionSetSha256",
    "specialistReview"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentSnapshotIdentity": {
      "type": "string",
      "pattern": "^liuyao-knowledge-snapshot-v1:sha256:[a-f0-9]{64}$"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "revision"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "decisionSetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "specialistReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewerName", "reviewerRole", "reviewedAt", "scope", "decision"],
      "properties": {
        "reviewerName": { "type": "string", "minLength": 1 },
        "reviewerRole": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "scope": { "type": "string", "minLength": 1 },
        "decision": { "const": "approved" }
      }
    }
  }
}
