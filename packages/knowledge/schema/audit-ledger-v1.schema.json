{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://liuyao.invalid/schema/audit-ledger-v1.schema.json",
  "title": "Liuyao audit ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ledgerId", "scope", "decisions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ledgerId": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["hexagram", "group"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "decisions": { "type": "array", "items": { "$ref": "#/definitions/decision" } }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyIdList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citationIds", "editionId", "pdfPages"],
      "properties": {
        "citationIds": { "$ref": "#/definitions/nonEmptyIdList" },
        "editionId": { "type": "string", "minLength": 1 },
        "pdfPages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "hexagramId", "editionId", "cell"],
          "properties": {
            "kind": { "const": "cell" },
            "hexagramId": { "type": "string", "pattern": "^hexagram-(0[1-9]|[1-5][0-9]|6[0-4])$" },
            "editionId": { "type": "string", "minLength": 1 },
            "cell": {
              "enum": [
                "overview",
                "position-1",
                "position-2",
                "position-3",
                "position-4",
                "position-5",
                "position-6"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["special", "sourceunit", "exclusion", "record"] },
            "id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "ownerId", "childId"],
          "properties": {
            "kind": { "enum": ["table", "figure", "lesson", "fixture"] },
            "id": { "type": "string", "minLength": 1 },
            "ownerId": { "type": "string", "minLength": 1 },
            "childId": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layerId", "presence", "citationIds", "basis"],
      "properties": {
        "layerId": { "type": "string", "minLength": 1 },
        "presence": { "enum": ["present", "absent"] },
        "citationIds": { "$ref": "#/definitions/nonEmptyIdList" },
        "basis": { "enum": ["inspected-page", "non-content", "source-omission"] }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "revision",
        "supersedes",
        "disposition",
        "findings",
        "locator",
        "coveredClaimIds",
        "layerResolution",
        "exclusionReview",
        "sourceComparison",
        "specialistReview",
        "authoredScope",
        "inputs",
        "recordedAt",
        "recordedBy"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$" },
        "target": { "$ref": "#/definitions/target" },
        "revision": { "type": "integer", "minimum": 1 },
        "supersedes": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "revision"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "revision": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "disposition": { "enum": ["accepted", "rejected", "unresolved", "excluded"] },
        "findings": { "type": "string" },
        "locator": { "$ref": "#/definitions/locator" },
        "coveredClaimIds": { "$ref": "#/definitions/idList" },
        "layerResolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "layers"],
          "properties": {
            "status": { "enum": ["unresolved", "resolved"] },
            "layers": { "type": "array", "items": { "$ref": "#/definitions/layer" } }
          }
        },
        "exclusionReview": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "locator", "scope", "reviewer"],
              "properties": {
                "reason": { "type": "string", "minLength": 1 },
                "locator": { "$ref": "#/definitions/locator" },
                "scope": { "type": "string", "minLength": 1 },
                "reviewer": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "sourceComparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "reviewer", "date", "scope", "evidenceCitationIds"],
          "properties": {
            "identity": { "type": "string", "minLength": 1 },
            "reviewer": { "type": "string", "minLength": 1 },
            "date": { "type": "string", "format": "date" },
            "scope": { "type": "string", "minLength": 1 },
            "evidenceCitationIds": { "$ref": "#/definitions/nonEmptyIdList" }
          }
        },
        "specialistReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewerName", "reviewerRole", "reviewedAt", "scope", "note"],
          "properties": {
            "status": { "enum": ["pending", "approved", "rejected"] },
            "reviewerName": { "type": ["string", "null"] },
            "reviewerRole": { "type": ["string", "null"] },
            "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
            "scope": { "type": "string", "minLength": 1 },
            "note": { "type": "string" }
          }
        },
        "authoredScope": { "enum": ["none", "records"] },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["records", "citations", "editions", "projectContracts", "fixtures"],
          "properties": {
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "sha256", "released"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "sha256": { "$ref": "#/definitions/sha256" },
                  "released": { "type": "boolean" }
                }
              }
            },
            "citations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "sha256"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "sha256": { "$ref": "#/definitions/sha256" }
                }
              }
            },
            "editions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "sha256"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "sha256": { "$ref": "#/definitions/sha256" }
                }
              }
            },
            "projectContracts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["documentPath", "revision"],
                "properties": {
                  "documentPath": { "type": "string", "minLength": 1 },
                  "revision": { "type": "string", "minLength": 1 }
                }
              }
            },
            "fixtures": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "sha256": { "$ref": "#/definitions/sha256" }
                }
              }
            }
          }
        },
        "recordedAt": { "type": "string", "format": "date-time" },
        "recordedBy": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "specialistReview": {
                "type": "object",
                "properties": { "status": { "const": "pending" } }
              }
            },
            "required": ["specialistReview"]
          },
          "then": {
            "properties": {
              "specialistReview": {
                "type": "object",
                "properties": {
                  "reviewerName": { "type": "null" },
                  "reviewerRole": { "type": "null" },
                  "reviewedAt": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "specialistReview": {
                "type": "object",
                "properties": { "status": { "enum": ["approved", "rejected"] } }
              }
            },
            "required": ["specialistReview"]
          },
          "then": {
            "properties": {
              "specialistReview": {
                "type": "object",
                "properties": {
                  "reviewerName": { "type": "string", "minLength": 1 },
                  "reviewerRole": { "type": "string", "minLength": 1 },
                  "reviewedAt": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "authoredScope": { "const": "none" } },
            "required": ["authoredScope"]
          },
          "then": {
            "properties": {
              "coveredClaimIds": { "type": "array", "maxItems": 0 },
              "inputs": {
                "type": "object",
                "properties": { "records": { "type": "array", "maxItems": 0 } }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "authoredScope": { "const": "records" } },
            "required": ["authoredScope"]
          },
          "then": {
            "properties": {
              "coveredClaimIds": { "type": "array", "minItems": 1 },
              "inputs": {
                "type": "object",
                "properties": { "records": { "type": "array", "minItems": 1 } }
              }
            }
          }
        }
      ]
    }
  }
}
