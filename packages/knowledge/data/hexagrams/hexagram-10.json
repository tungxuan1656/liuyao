      "label": "Sơ cửu",
      "claims": [
        {
          "id": "hexagram-10-line-1-nhl",
          "kind": "author-interpretation",
          "text": "Bước đầu ra đời cần giữ sự giản dị, trong sạch và chí hướng ban đầu. Theo lời giảng, tiến bước với phẩm chất ấy giúp tránh lỗi.",
          "citationIds": ["citation-nhl-p166-167-commentary"],
          "attribution": {
            "author": "Nguyễn Hiến Lê"
          }
        }
      ]
    },
    {
      "position": 2,
      "polarity": "yang",
      "label": "Cửu nhị",
      "claims": [
        {
          "id": "hexagram-10-line-2-nhl",
          "kind": "author-interpretation",
          "text": "Hình ảnh đường bằng nói về sự bình thản và giữ đạo trung. Dù thiếu người hợp sức, người học vẫn cần bền với đường chính.",
          "citationIds": ["citation-nhl-p167-commentary"],
          "attribution": {
            "author": "Nguyễn Hiến Lê"
          }
        }
      ]
    },
    {
      "position": 3,
      "polarity": "yin",
      "label": "Lục tam",
      "claims": [
        {
          "id": "hexagram-10-line-3-nhl",
          "kind": "author-interpretation",
          "text": "Không đánh giá đúng năng lực mà tự phụ tiến vào việc lớn sẽ gặp nguy. Hình ảnh người nhìn và đi khó khăn được dùng để răn việc vượt quá khả năng thực.",
          "citationIds": ["citation-nhl-p167-commentary"],
          "attribution": {
            "author": "Nguyễn Hiến Lê"
          }
        }
      ]
    },
    {
      "position": 4,
      "polarity": "yang",
      "label": "Cửu tứ",
      "claims": [
        {
          "id": "hexagram-10-line-4-nhl",
          "kind": "author-interpretation",
          "text": "Gặp nơi nguy hiểm cần giữ sự dè dặt và cảnh giác. Nguyễn Hiến Lê đối chiếu hào này với hào ba để nhấn mạnh tác dụng của việc biết sợ và biết thận trọng.",
          "citationIds": ["citation-nhl-p167-commentary"],
          "attribution": {
            "author": "Nguyễn Hiến Lê"
          }
        }
      ]
    },
    {
      "position": 5,
      "polarity": "yang",
      "label": "Cửu ngũ",
      "claims": [
        {
          "id": "hexagram-10-line-5-nhl",
          "kind": "author-interpretation",
          "text": "Ở vị trí có quyền lực, quyết đoán quá mức có thể thành tự phụ. Ngay cả ý định đúng cũng cần được thực hiện với sự cân nhắc về nguy cơ.",
          "citationIds": ["citation-nhl-p168-commentary"],
          "attribution": {
            "author": "Nguyễn Hiến Lê"
          }
        }
      ]
    },
    {
      "position": 6,
      "polarity": "yang",
      "label": "Thượng cửu",
      "claims": [
        {
          "id": "hexagram-10-line-6-nhl",
          "kind": "author-interpretation",
          "text": "Cuối quá trình cần nhìn lại cách sống và hành động đã qua. Nguyễn Hiến Lê đọc hào này như sự tổng kết toàn quẻ, đánh giá kết quả theo mức trọn vẹn của cách ứng xử.",
          "citationIds": ["citation-nhl-p168-commentary"],
          "attribution": {
            "author": "Nguyễn Hiến Lê"
          }
        }
      ]
    }
