  "claims": [
    {
      "id": "hexagram-10-structure",
      "kind": "structural-fact",
      "text": "Thiên Trạch Lý có ngoại quái Càn và nội quái Đoài. Hào được đếm từ dưới lên.",
      "citationIds": ["citation-nhl-p166-commentary", "citation-nhl-p59-61-technical"]
    },
    {
      "id": "hexagram-10-nhl-overview",
      "kind": "author-interpretation",
      "text": "Nguyễn Hiến Lê giải thích Lý qua cách ứng xử khi sự mềm thuận, vui vẻ gặp sức cương mạnh. Sáu hào được đọc như những lời nhắc về sự chất phác, biết sức mình, thận trọng và tránh tự phụ.",
      "citationIds": ["citation-nhl-p166-commentary", "citation-nhl-p168-commentary"],
      "attribution": {
        "author": "Nguyễn Hiến Lê"
      }
    },
    {
      "id": "hexagram-10-pbc-overview",
      "kind": "author-interpretation",
      "text": "Phan Bội Châu liên hệ Lý với lễ và cách đứng vững trong quan hệ xã hội. Sự hòa duyệt của nội Đoài khi ứng phó với tính cương của ngoại Càn là trọng tâm cách ông giảng hình ảnh gặp nguy mà giữ được mình.",
      "citationIds": ["citation-pbc-p135-136-commentary"],
      "attribution": {
        "author": "Phan Bội Châu"
      }
    },
    {
      "id": "hexagram-10-ntt-overview",
      "kind": "author-interpretation",
      "text": "Trong bản Ngô Tất Tố dịch, Trình Di đọc Lý như con đường ứng xử của con người, còn Chu Hy nhấn mạnh sự hòa thuận của Đoài khi theo Càn. Hai lớp bình luận đều gắn khả năng vượt chỗ nguy với cách hành xử phù hợp.",
      "citationIds": ["citation-ntt-p248-249-commentary"],
      "attribution": {
        "author": "Trình Di; Chu Hy",
        "via": "Ngô Tất Tố — dịch và chú giải"
      }
    }
  ],
