  "entries": [
    {
      "text": "Tương sinh theo vòng Mộc → Hỏa → Thổ → Kim → Thủy → Mộc. Tương khắc theo vòng Mộc → Thổ → Thủy → Hỏa → Kim → Mộc. Chiều quan hệ phải được giữ đúng khi phân loại Lục thân.",
      "references": [
        {
          "sourceId": "source-book-bpct",
          "pdfPages": [9, 9],
          "section": "IV–V — Ngũ hành sinh khắc và Lục thân sinh khắc",
          "printedPages": ["3", "3"]
        }
      ]
    }
  ],
