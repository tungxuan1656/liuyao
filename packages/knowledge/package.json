{
  "name": "@liuyao/knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "development": "./src/node.ts",
      "import": "./dist/src/node.js",
      "default": "./dist/src/node.js"
    }
  },
  "scripts": {
    "build": "pnpm validate:corpus && tsc",
    "typecheck": "pnpm validate:corpus && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm validate:corpus && vitest run --maxWorkers=1 --no-file-parallelism",
    "validate:corpus": "node scripts/validate-corpus.mjs"
  },
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@liuyao/core": "workspace:*",
    "@types/node": "^24.19.1",
    "ajv": "^8.20.0"
  }
}
